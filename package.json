{
  "name": "kuberiq-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5199",
    "build": "tsc -b && vite build",
    "build:wix": "npm run build && node scripts/build-wix.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5199",
    "test": "node --test tests/*.test.mjs",
    "test:security": "npm run build && node --test tests/security/*.test.mjs"
  },
  "dependencies": {
    "lenis": "1.3.27",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
